<?xml version="1.0" encoding="utf-8"?>
<!-- The IIS-hosted API is served over plain HTTP on the local network, so cleartext is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
