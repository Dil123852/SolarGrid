<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SolarGrid.Api</RootNamespace>
    <AssemblyName>SolarGrid</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SolarGrid.Application\SolarGrid.Application.csproj" />
    <ProjectReference Include="..\SolarGrid.Infrastructure\SolarGrid.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local secrets are copied on build/publish when present, but never committed. -->
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

</Project>
